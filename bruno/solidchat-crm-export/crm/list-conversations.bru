meta {
  name: List Conversations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}{{basePath}}/conversations
  body: none
  auth: none
}

params:query {
  email: {{email}}
  site_id: {{siteId}}
}

headers {
  Authorization: Bearer {{crmApiKey}}
  Accept: application/json
}

vars:post-response {
  conversationId: $res.body.data[0].id
}

assert {
  $res.status: 200
}

docs {
  Lists conversations assigned to/handled by the agent with this email. On success, the first
  returned conversation id is stored into the request variable `conversationId` for chaining
  into the detail request. `site_id` is only required when the API key can read more than one
  site.
}
