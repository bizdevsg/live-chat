NODE_ENV=development
APP_NAME=SolidChat AI

API_PORT=4000
DASHBOARD_PORT=3000
WIDGET_PORT=3001

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WIDGET_URL=http://localhost:3001

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=solidchat
MYSQL_USER=solidchat
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
# Used by apps/api and apps/worker directly; when running docker-compose the host is "mysql",
# when running services on the host machine (pnpm dev) use "localhost".
DATABASE_URL=mysql://solidchat:change_me_mysql_password@localhost:3306/solidchat

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MARKET_DATA_WS_ENABLED=true
MARKET_DATA_WS_URL=wss://wsprc.royalassetindo.co.id
MARKET_DATA_WS_SUBSCRIBE_MESSAGE=
MARKET_DATA_WS_RECONNECT_MS=5000
MARKET_DATA_MAX_QUOTE_AGE_MS=30000

JWT_ACCESS_SECRET=change_me_access_secret_min_16_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Used to sign/verify short-lived anonymous widget visitor tokens. Falls back to
# JWT_ACCESS_SECRET if unset.
VISITOR_TOKEN_SECRET=change_me_visitor_secret_min_16_chars

# Shared secret used to verify the signed customer-identity JWT issued by the Solid Gold
# main-site backend (§9). Must match what that backend signs with.
CUSTOMER_IDENTITY_JWT_SECRET=change_me_customer_identity_secret
CUSTOMER_IDENTITY_ISSUER=sg-berjangka.com
CUSTOMER_IDENTITY_AUDIENCE=solidchat

# Required — there is no mock/dummy AI mode. Model names (gpt-4o-mini, text-embedding-3-small)
# are fixed in packages/shared/src/constants.ts, not configured via env or dashboard.
OPENAI_API_KEY=

# Outbound: SolidChat pushing leads/tickets to a CRM (leads.module.ts).
CRM_PROVIDER=mock
CRM_BASE_URL=
CRM_API_KEY=

# Inbound: Clara pulling conversations via GET /api/v1/conversations (Kebutuhan API Live Chat
# dan SSO Dashboard untuk Integrasi Clara v1.1, §3-§5). One credential per site, least privilege:
# CRM_API_KEYS=[{"key":"REPLACE_ME","siteIds":["solid-gold-main"],"label":"clara-prod"}]
CRM_API_KEYS=
# Legacy fallback if CRM_API_KEYS is unset: a single key with unrestricted (all-sites) read
# access. Kept only for backward compatibility — prefer CRM_API_KEYS for new deployments.
CRM_INBOUND_API_KEY=
# Optional comma-separated allowlist of Clara's backend egress IPs (§14, "jika memungkinkan").
CRM_ALLOWED_IPS=

# Outbound the other way: Live Chat as OAuth/OIDC client, logging agents into the Dashboard via
# their Clara account (Kebutuhan API Live Chat dan SSO Dashboard §4A / Bagian B). Leave blank to
# keep this feature off — regular email/password login is unaffected either way.
# CRM_SSO_ISSUER=https://crm.sg-berjangka.com/api
CRM_SSO_ISSUER=
CRM_SSO_CLIENT_ID=live-chat-dashboard
# Secret must come from Tim Clara via a secure channel — never commit a real value here.
CRM_SSO_CLIENT_SECRET=
# Exact URL registered with Clara for this environment (staging/production each need their own
# client registration + redirect URI — see docs/sso-clara-integration.md).
# CRM_SSO_REDIRECT_URI=https://api-chat.sg-berjangka.com/api/v1/auth/clara/callback
CRM_SSO_REDIRECT_URI=
CRM_SSO_ALLOWED_ROLES=sales,manager,head,superadmin
CRM_SSO_ALLOWED_ORGANIZATION_ID=
CRM_SSO_STATE_TTL_SECONDS=600
CRM_SSO_POST_LOGIN_PATH=/dashboard
# Akun agent dibuat OTOMATIS dari akun Clara saat login pertama — tidak perlu dibuatkan
# manual dulu di Live Chat. CRM_SSO_DEFAULT_ORGANIZATION_SLUG menentukan organization yang
# menampung akun baru itu (default cocok dengan organization hasil `prisma db seed`).
CRM_SSO_DEFAULT_ORGANIZATION_SLUG=solid-gold
# Pemetaan role Clara -> role Live Chat, dipakai saat provisioning akun baru.
CRM_SSO_ROLE_MAP=sales:cs_agent,manager:supervisor,head:admin,superadmin:super_admin

S3_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint for presigned download URLs (image attachments etc). Leave empty to
# reuse S3_ENDPOINT. In Docker, compose overrides S3_ENDPOINT with http://minio:9000, so this must
# stay a host address. Production: the public MinIO/S3 domain behind TLS.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=solidchat
S3_SECRET_KEY=change_me_minio_secret
S3_BUCKET=solidchat
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=solidchat
MINIO_ROOT_PASSWORD=change_me_minio_secret

# 32+ character key used to derive the AES-256-GCM key for encrypting integration credentials at rest.
ENCRYPTION_KEY=change_me_encryption_key_32_chars_min
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_LANGUAGE=id

INITIAL_ADMIN_EMAIL=admin@solidgold.local
INITIAL_ADMIN_NAME=SolidChat Admin
INITIAL_ADMIN_PASSWORD=ChangeMe!12345

# Consumed by apps/dashboard and apps/widget at build/runtime (must be prefixed for their
# respective bundlers to expose them to the browser).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3001
# Shows/hides the "Masuk dengan Clara" button on the login page — flip to true once
# CRM_SSO_* above is fully configured and redirect URIs are registered with Tim Clara.
NEXT_PUBLIC_CRM_SSO_ENABLED=false
VITE_API_URL=http://localhost:4000
