{
  "name": "@solidchat/ai-core",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@solidchat/database": "workspace:*",
    "@solidchat/shared": "workspace:*",
    "openai": "^4.68.1"
  },
  "devDependencies": {
    "@solidchat/eslint-config": "workspace:*",
    "@solidchat/typescript-config": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }] },
    "testRegex": ".*\\.spec\\.ts$"
  }
}
