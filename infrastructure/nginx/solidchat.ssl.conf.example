# Production TLS example for SolidChat AI (§42). Copy to solidchat.ssl.conf, fill in real
# domains, and obtain certificates with Certbot before enabling:
#
#   sudo certbot certonly --nginx \
#     -d chat.sg-berjangka.com -d api-chat.sg-berjangka.com -d cs-chat.sg-berjangka.com
#
# Certbot writes certs to /etc/letsencrypt/live/<primary-domain>/{fullchain,privkey}.pem —
# adjust the paths below to match. Renewal is handled by certbot's own systemd timer/cron;
# nginx just needs a `nginx -s reload` after renewal (certbot's default hook does this).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

limit_req_zone $binary_remote_addr zone=solidchat_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=solidchat_widget_session:10m rate=5r/s;

gzip on;
gzip_types text/plain application/json application/javascript text/css application/xml;
gzip_min_length 512;

# Redirect all plain HTTP to HTTPS.
server {
    listen 80;
    server_name chat.sg-berjangka.com api-chat.sg-berjangka.com cs-chat.sg-berjangka.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# ── chat.sg-berjangka.com — widget iframe app + widget.js ───────────────────
server {
    listen 443 ssl http2;
    server_name chat.sg-berjangka.com;

    ssl_certificate     /etc/letsencrypt/live/chat.sg-berjangka.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.sg-berjangka.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 20m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # Intentionally no X-Frame-Options / frame-ancestors restriction here — this origin is
    # meant to be iframed by allowlisted Solid Gold domains (enforced server-side, §8).

    location = /widget.js {
        proxy_pass http://widget:80;
        add_header Cache-Control "public, max-age=300";
    }

    location / {
        limit_req zone=solidchat_general burst=40 nodelay;
        proxy_pass http://widget:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── api-chat.sg-berjangka.com — NestJS API + Socket.IO ──────────────────────
server {
    listen 443 ssl http2;
    server_name api-chat.sg-berjangka.com;

    ssl_certificate     /etc/letsencrypt/live/chat.sg-berjangka.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.sg-berjangka.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 20m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    location /socket.io/ {
        proxy_pass http://api:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/v1/widget/session {
        limit_req zone=solidchat_widget_session burst=10 nodelay;
        proxy_pass http://api:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=solidchat_general burst=40 nodelay;
        proxy_pass http://api:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ── cs-chat.sg-berjangka.com — Admin/CS dashboard ───────────────────────────
server {
    listen 443 ssl http2;
    server_name cs-chat.sg-berjangka.com;

    ssl_certificate     /etc/letsencrypt/live/chat.sg-berjangka.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.sg-berjangka.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    location /socket.io/ {
        proxy_pass http://api:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    location /_next/static/ {
        proxy_pass http://dashboard:3000;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://dashboard:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
