{
  "name": "@solidchat/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }] },
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": ["js", "json", "ts"]
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/terminus": "^10.2.3",
    "@solidchat/ai-core": "workspace:*",
    "@solidchat/database": "workspace:*",
    "@solidchat/integrations": "workspace:*",
    "@solidchat/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nanoid": "^3.3.7",
    "nestjs-pino": "^4.1.0",
    "openai": "^4.68.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "minio": "^8.0.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "zod": "^3.23.8",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "sanitize-html": "^2.13.1",
    "multer": "^1.4.5-lts.1",
    "csv-parse": "^5.5.6",
    "file-type": "^16.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@solidchat/eslint-config": "workspace:*",
    "@solidchat/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/sanitize-html": "^2.13.0",
    "@types/node": "^20.16.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
